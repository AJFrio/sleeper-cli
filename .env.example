# Copy to .env and fill in, or export these directly. Nothing here is read from a file
# automatically — the CLI reads the process environment. The point of this file is to
# list the supported variables.

# A Sleeper session token. Takes precedence over any stored credential, and nothing is
# written to disk when this is set. Obtain one with `sleeper auth login`, or
# `sleeper auth token --reveal` to move one between machines.
SLEEPER_TOKEN=

# Credentials for `sleeper auth login`. Supplying these lets login run non-interactively,
# which is what CI needs. The password is never persisted.
SLEEPER_USERNAME=
SLEEPER_PASSWORD=

# A one-shot two-factor code, for an account that has 2FA enabled.
SLEEPER_OTP=

# Relocate config and credentials. Defaults to ~/.config/sleeper-cli.
SLEEPER_CLI_HOME=

# Relocate the player cache. Defaults to ~/.cache/sleeper-cli.
SLEEPER_CLI_CACHE_DIR=
